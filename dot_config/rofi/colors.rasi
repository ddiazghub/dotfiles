* {
    primary: #99cbfd;
    primary-fixed: #cee5ff;
    primary-fixed-dim: #99cbfd;
    on-primary: #003353;
    on-primary-fixed: #001d32;
    on-primary-fixed-variant: #054a75;
    primary-container: #1e5883;
    on-primary-container: #f4f8ff;
    secondary: #b6c8de;
    secondary-fixed: #d1e4fb;
    secondary-fixed-dim: #b6c8de;
    on-secondary: #203243;
    on-secondary-fixed: #091d2d;
    on-secondary-fixed-variant: #37485a;
    secondary-container: #394b5d;
    on-secondary-container: #d3e6fc;
    tertiary: #f5bd6c;
    tertiary-fixed: #ffddb2;
    tertiary-fixed-dim: #f5bd6c;
    on-tertiary: #452b00;
    on-tertiary-fixed: #291800;
    on-tertiary-fixed-variant: #624000;
    tertiary-container: #744c00;
    on-tertiary-container: #fff6ee;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: rgba(17, 20, 22, 0.7);
    on-surface: #e1e2e6;
    on-surface-variant: #c1c7cf;
    outline: #8b9199;
    outline-variant: #41474e;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e1e2e6;
    inverse-on-surface: #2e3134;
    inverse-primary: #2b628e;
    surface-dim: rgba(17, 20, 22, 0.7);
    surface-bright: #37393d;
    surface-container-lowest: rgba(12, 14, 17, 0.7);
    surface-container-low: rgba(25, 28, 31, 0.7);
    surface-container: rgba(29, 32, 35, 0.7);
    surface-container-high: rgba(40, 42, 45, 0.7);
    surface-container-highest: rgba(51, 53, 56, 0.7);

    /* Convenience aliases with full opacity for text backgrounds */
    surface-solid: #111416;
    surface-container-solid: #1d2023;
}
